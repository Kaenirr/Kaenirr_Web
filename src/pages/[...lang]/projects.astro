---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { localeStaticPaths, toLocale, ui, type Localized } from "../../i18n";

export const getStaticPaths = localeStaticPaths;

const locale = toLocale(Astro.params.lang);
const t = ui[locale];

interface Project {
  title: Localized<string>;
  description: Localized<string>;
  href?: string;
  tags: string[];
}

const projects: Project[] = [
  {
    title: { en: "Vibosaurus", cs: "Vibosaurus" },
    description: {
      en: "Windows desktop app for Mistral Vibe: a chat interface that runs Vibe's coding agent over the Agent Client Protocol, with sign-in and tool-call approvals. In development.",
      cs: "Desktopová aplikace pro Windows k Mistral Vibe: chatové rozhraní, které spouští programovacího agenta Vibe přes Agent Client Protocol, včetně přihlášení a schvalování akcí. Ve vývoji.",
    },
    tags: ["ai-coding", "TypeScript", "Electron", "React"],
  },
];
---

<Layout title={`${t.nav.projects} — Kaenirr`}>
  <section class="page">
    <h1>{t.nav.projects}</h1>
    <div class="grid">
      {
        projects.map((project) => (
          <ProjectCard
            {...project}
            title={project.title[locale]}
            description={project.description[locale]}
          />
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .page {
    padding: 3rem 0;
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    margin: 0 0 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
</style>
