---
import Layout from "../../layouts/Layout.astro";
import SkillTag from "../../components/SkillTag.astro";
import { formatDuration, monthIndex } from "../../lib/duration";
import { localeStaticPaths, toLocale, ui, type Localized } from "../../i18n";

export const getStaticPaths = localeStaticPaths;

const locale = toLocale(Astro.params.lang);
const t = ui[locale];

interface Entry {
  title: Localized<string>;
  company: string;
  companyUrl?: string;
  location: Localized<string>;
  type: Localized<string>;
  start: string;
  end: string | null;
  summary: Localized<string>;
  skills?: string[];
}

const entries: Entry[] = [
  {
    title: { en: "3D Artist/Programmer", cs: "3D grafik/programátor" },
    company: "Trisgram",
    companyUrl: "https://trisgram.com",
    location: { en: "Pilsen", cs: "Plzeň" },
    type: { en: "Full-time", cs: "Plný úvazek" },
    start: "2022-09",
    end: null,
    summary: { en: "Where it began.", cs: "Tady to všechno začalo." },
    skills: [
      "csharp",
      "unity",
      "trisgine",
      "blender",
      "substance-painter",
      "drone-pilot",
    ],
  },
];

const formatMonth = (ym: string | null) => {
  if (!ym) return t.experience.present;
  const [y, m] = ym.split("-").map(Number);
  return new Date(y, m - 1).toLocaleString(locale, {
    month: "short",
    year: "numeric",
  });
};

const sorted = [...entries].sort(
  (a, b) => monthIndex(b.start) - monthIndex(a.start),
);
---

<Layout title={`${t.nav.experience} — Kaenirr`}>
  <section class="page">
    <h1>{t.nav.experience}</h1>

    <ol class="timeline">
      {
        sorted.map((entry) => (
          <li class="entry">
            <span class="dot" aria-hidden="true" />
            <article class="glow-card card" data-tilt>
              <span class="glow" aria-hidden="true" />
              <div class="content">
                <header>
                  <h2>{entry.title[locale]}</h2>
                  <ul class="meta">
                    <li>
                      {entry.companyUrl ? (
                        <a href={entry.companyUrl} target="_blank" rel="noopener noreferrer">
                          {entry.company} <span aria-hidden="true">↗</span>
                        </a>
                      ) : (
                        entry.company
                      )}
                    </li>
                    <li>{entry.location[locale]}</li>
                    <li>{entry.type[locale]}</li>
                  </ul>
                </header>

                <p class="period">
                  {formatMonth(entry.start)} — {formatMonth(entry.end)}
                  <span
                    class="duration"
                    data-ongoing-since={entry.end === null ? entry.start : undefined}
                  >
                    · {formatDuration(entry.start, entry.end, locale)}
                  </span>
                </p>

                <p class="summary">{entry.summary[locale]}</p>

                <ul class="skills">
                  {(entry.skills ?? []).map((skill) => (
                    <li>
                      <SkillTag id={skill} />
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>

<script>
  import { formatDuration } from "../../lib/duration";
  import { toLocale } from "../../i18n";

  const locale = toLocale(document.documentElement.lang);

  for (const el of document.querySelectorAll<HTMLElement>(
    "[data-ongoing-since]",
  )) {
    el.textContent = `· ${formatDuration(el.dataset.ongoingSince!, null, locale)}`;
  }
</script>

<style>
  .page {
    padding: 3rem 0;
  }

  h1 {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    margin: 0 0 2.5rem;
  }

  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 16px;
    width: 2px;
    background: linear-gradient(var(--accent), transparent);
  }

  .entry {
    position: relative;
    padding-left: 48px;
    margin-bottom: 2rem;
  }

  .dot {
    position: absolute;
    left: 16px;
    top: 28px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg);
    box-shadow: 0 0 0 2px var(--accent);
    transform: translateX(-50%);
  }

  .card {
    padding: 1.5rem;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  h2 {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .meta li {
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .meta li:has(> a) {
    padding: 0;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .meta a {
    display: block;
    padding: 0.2rem 0.6rem;
    border-radius: inherit;
    color: inherit;
    transition: color 0.15s ease;
  }

  .meta li:has(> a:hover) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .meta a:hover {
    color: var(--accent);
  }

  .period {
    margin: 0;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .duration {
    color: var(--text-muted);
    font-weight: 400;
  }

  .summary {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 820px) {
    .timeline::before {
      left: 50%;
    }

    .entry {
      width: 50%;
      padding-left: 0;
    }

    .entry:nth-child(odd) {
      margin-left: auto;
      padding-left: 40px;
    }

    .entry:nth-child(even) {
      padding-right: 40px;
    }

    .dot {
      top: 28px;
    }

    .entry:nth-child(odd) .dot {
      left: 0;
    }

    .entry:nth-child(even) .dot {
      left: 100%;
    }
  }
</style>
