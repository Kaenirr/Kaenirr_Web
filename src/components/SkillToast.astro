---
import { skills } from "../data/skills";
---

<dialog id="skill-toast" class="skill-toast" aria-labelledby="skill-toast-name">
  <div class="inner">
    <button class="close" type="button" aria-label="Close">✕</button>
    <span class="cat"></span>
    <h2 id="skill-toast-name" class="name"></h2>
    <div class="desc"></div>
  </div>
</dialog>

<style>
  .skill-toast {
    width: min(420px, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-raised);
    color: var(--text);
    box-shadow: var(--shadow);
  }

  .skill-toast::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
  }

  .inner {
    position: relative;
    padding: 1.75rem;
  }

  .close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }

  .close:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .cat {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
  }

  .name {
    margin: 0.4rem 0 0.6rem;
    font-size: 1.5rem;
  }

  .desc {
    color: var(--text-muted);
    line-height: 1.6;
  }

  .desc :global(p) {
    margin: 0 0 0.7rem;
    white-space: pre-line;
  }

  .desc :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .skill-toast[open] {
      animation: pop 0.18s ease;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }
</style>

<script is:inline define:vars={{ skills }}>
  const dialog = document.getElementById("skill-toast");
  const byId = Object.fromEntries(skills.map((s) => [s.id, s]));
  const nameEl = dialog.querySelector(".name");
  const catEl = dialog.querySelector(".cat");
  const descEl = dialog.querySelector(".desc");

  document.addEventListener("click", (event) => {
    const trigger = event.target.closest("[data-skill]");
    if (!trigger) return;
    const skill = byId[trigger.getAttribute("data-skill")];
    if (!skill) return;
    event.preventDefault();
    nameEl.textContent = skill.name;
    catEl.textContent = skill.category;
    descEl.replaceChildren();
    const paragraphs = Array.isArray(skill.description)
      ? skill.description
      : [skill.description];
    for (const paragraph of paragraphs) {
      const p = document.createElement("p");
      p.textContent = paragraph;
      descEl.appendChild(p);
    }
    if (!dialog.open) dialog.showModal();
  });

  dialog.querySelector(".close").addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
