---
import { navItems, siteName } from "../nav";
import { localeLabels, localizePath, toLocale, ui, unlocalizePath } from "../i18n";
import ThemeToggle from "./ThemeToggle.astro";

const locale = toLocale(Astro.params.lang);
const otherLocale = locale === "en" ? "cs" : "en";
const t = ui[locale];
const page = unlocalizePath(Astro.url.pathname);
---

<header>
  <nav class="container">
    <a class="brand" href={localizePath("/", locale)}>{siteName}</a>

    <ul class="links">
      {
        navItems.map((item) => (
          <li>
            <a
              href={localizePath(item.href, locale)}
              aria-current={page === item.href ? "page" : undefined}
            >
              {t.nav[item.key]}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="toggle-slot">
      <a
        id="lang-toggle"
        href={localizePath(page, otherLocale)}
        hreflang={otherLocale}
        lang={otherLocale}
        aria-label={t.switchLanguage}
        title={t.switchLanguage}
      >
        {localeLabels[otherLocale]}
      </a>
      <ThemeToggle label={t.toggleTheme} />
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    @media (prefers-reduced-transparency: no-preference) {
      header {
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        background: color-mix(in srgb, var(--bg) 82%, transparent);
      }
    }
  }

  nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 64px;
  }

  .brand {
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
  }

  .links {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-self: center;
  }

  .links a {
    position: relative;
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    color: var(--text-muted);
    font-weight: 500;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .links a:hover {
    color: var(--text);
    background: var(--accent-soft);
  }

  .links a[aria-current="page"] {
    color: var(--accent);
  }

  .toggle-slot {
    display: flex;
    gap: 0.5rem;
    justify-self: end;
  }

  #lang-toggle {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition:
      border-color 0.2s ease,
      transform 0.15s ease;
  }

  #lang-toggle:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  @media (max-width: 560px) {
    nav {
      grid-template-columns: 1fr auto;
      grid-template-rows: 56px auto;
      height: auto;
      padding-bottom: 0.5rem;
    }

    .links {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: stretch;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0 0.25rem;
    }

    .links a {
      padding: 0.4rem 0.45rem;
      font-size: 0.9rem;
    }
    .brand {
      font-size: 1rem;
    }
  }
</style>
